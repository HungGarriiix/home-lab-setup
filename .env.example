# Environment settings
VOLUMES_DIR = <input your volumes directory path here>

# Host ports (published on the host, mapped to each container's fixed internal port)
PORTAINER_PORT = 9443
DOCKGE_PORT = 5001
HOMER_PORT = 8080
HOMEPAGE_PORT = 3100
TRAEFIK_HTTP_PORT = 80
TRAEFIK_DASHBOARD_PORT = 8081

# Group id owning /var/run/docker.sock (find it with: stat -c %g /var/run/docker.sock)
# Homepage runs with this group so it can read the socket for service discovery
DOCKER_GID = 986

# Host name the Traefik routes hang off: each service is served at <service>.${LAB_HOSTNAME}
# (*.localhost resolves to 127.0.0.1 in browsers; use a real domain/DNS name to reach the lab from other machines)
LAB_HOSTNAME = localhost

# Service URLs (as reached from the browser through Traefik, used by Homer and Homepage labels)
# Assume TRAEFIK_HTTP_PORT = 80; append :${TRAEFIK_HTTP_PORT} to the host if it differs
PORTAINER_URL = http://portainer.${LAB_HOSTNAME}/
DOCKGE_URL = http://dockge.${LAB_HOSTNAME}/
HOMER_URL = http://homer.${LAB_HOSTNAME}/
HOMEPAGE_URL = http://homepage.${LAB_HOSTNAME}/
TRAEFIK_URL = http://traefik.${LAB_HOSTNAME}/

# Version tags

# Keys
PORTAINER_SETUP_TOKEN = <abcd1234efgh5678ijkl9012mnop3456qrst7890uvwx1234yzab5678cdef9012gh>