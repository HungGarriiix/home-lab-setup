# Environment settings
VOLUMES_DIR = <input your volumes directory path here>

# Host ports (published on the host, mapped to each container's fixed internal port)
PORTAINER_PORT = 9443
DOCKGE_PORT = 5001
HOMER_PORT = 8080
HOMEPAGE_PORT = 3100

# Group id owning /var/run/docker.sock (find it with: stat -c %g /var/run/docker.sock)
# Homepage runs with this group so it can read the socket for service discovery
DOCKER_GID = 986

# Service URLs (as reached from the browser, used by Homer and Homepage labels)
PORTAINER_URL = https://localhost:${PORTAINER_PORT}/
DOCKGE_URL = http://localhost:${DOCKGE_PORT}/
HOMER_URL = http://localhost:${HOMER_PORT}/
HOMEPAGE_URL = http://localhost:${HOMEPAGE_PORT}/

# Version tags

# Keys
PORTAINER_SETUP_TOKEN = <abcd1234efgh5678ijkl9012mnop3456qrst7890uvwx1234yzab5678cdef9012gh>